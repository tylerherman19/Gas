# Supabase project that also hosts the fantasy football tables.
# Project settings -> API

# Read-only, safe to expose to the browser. Used by the dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Full access, bypasses RLS. Used ONLY by scripts/scrape.mjs.
# Set this as a GitHub Actions secret, never in the frontend.
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
